#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&led_strip {
    chain-length = <29>; // Sofle Using All LEDs
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        holdTap: holdTap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "tap-preferred";
        };

        doubleTapA: doubleTapA {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLETAPA";
            #binding-cells = <0>;
            bindings = <&holdTap LEFT_SHIFT A>, <&kp LS(A)>;
        };

        doubleTapCedilha: doubleTapCedilha {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLETAPCEDILHA";
            #binding-cells = <0>;
            bindings = <&holdTap LEFT_SHIFT SEMI>, <&kp LS(SEMI)>;
        };

        holdTap2: holdTap2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP2";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };
    };

    macros {
        altTab: altTab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "ALTTAB";
        };
    };

    combos {
        compatible = "zmk,combos";

        teste {
            bindings = <&to 0>;
            key-positions = <36 49>;
        };

        teste2 {
            bindings = <&to 0>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE      &kp N1  &kp N2        &kp N3        &kp N4        &kp N5                                  &kp N6           &kp N7  &kp N8   &kp N9     &kp N0                   &kp DELETE
&kp TAB         &kp Q   &kp W         &kp E         &kp R         &kp T                                   &kp Y            &kp U   &kp I    &kp O      &kp P                    &kp K_CMENU
&kp LEFT_SHIFT  &kp A   &kp S         &kp D         &kp F         &kp G                                   &kp H            &kp J   &kp K    &kp L      &kp SEMI                 &kp SQT
&kp LCTRL       &kp Z   &kp X         &kp C         &kp V         &kp B   &kp C_MUTE    &kp C_PLAY_PAUSE  &kp N            &kp M   &kp DOT  &kp RA(Q)  &holdTap QUESTION SLASH  &kp RSHFT
                        &kp CAPSLOCK  &kp LEFT_GUI  &kp LEFT_ALT  &mo 3   &kp SPACE     &kp ENTER         &lt 1 BACKSPACE  &mo 2   &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_UP>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        moves {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans                      &trans     &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &kp INSERT  &kp HOME                    &kp PG_UP  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans      &kp END                     &kp PG_DN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans    &trans    &trans  &trans     &kp QUESTION    &kp COMMA       &kp RA(W)        &trans  &trans
                &trans  &trans  &trans      &trans    &trans    &trans  &trans     &trans          &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        number {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F9  &kp F10  &kp F11  &kp F12                    &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
                &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Simbols {
            display-name = "lower";
            bindings = <
&trans     &trans       &trans         &trans        &trans     &trans                       &trans    &trans    &trans           &trans            &trans  &trans
&kp GRAVE  &trans       &trans         &trans        &trans     &trans                       &trans    &trans    &kp SEMI         &trans            &trans  &trans
&trans     &kp EXCL     &kp MINUS      &kp PLUS      &kp EQUAL  &kp PRCNT                    &kp RBKT  &kp LPAR  &kp RIGHT_BRACE  &kp LESS_THAN     &trans  &trans
&trans     &kp PERCENT  &kp AMPERSAND  &kp ASTERISK  &kp HASH   &kp AT     &trans    &trans  &kp BSLH  &kp RPAR  &kp PIPE         &kp GREATER_THAN  &trans  &trans
                        &trans         &trans        &trans     &trans     &trans    &trans  &trans    &trans    &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };
    };
};
