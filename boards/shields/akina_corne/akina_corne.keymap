/*
 * Keymap de diagnóstico — Akina Corne Esquerdo
 *
 * Cada tecla emite um caractere/tecla único para identificação dos pinos.
 * Quando você pressionar uma tecla física e ver o output, consulte a tabela:
 *
 * TABELA DE REFERÊNCIA (diode-direction = col2row):
 *
 *          col0   col1   col2   col3   col4   col5
 *          pm4    pm5    pm6    pm7    pm8    pm9
 * row0 pm10  1      2      3      4      5      6
 * row1 pm11  Q      W      E      R      T      Y
 * row2 pm12  A      S      D      F      G      H
 * row3 pm13  Z      X      C      V      B      N
 * row4 pm14  F1     F2     F3     F4     F5     F6
 * row5 pm15  F7     F8     F9     F10    F11    F12
 * row6 pm16  F13    F14    F15    F16    F17    F18
 * row7 pm17  F19    F20    F21    F22    F23    F24
 * row8 pm18  ESC    TAB    BSPC   DEL    ENTER  SPACE
 * row9 pm19  UP     DOWN   LEFT   RIGHT  INS    PSCRN
 *
 * Exemplo: você pressiona uma tecla e aparece "F5"
 *   → row4 (pro_micro 14 = P0.03) × col4 (pro_micro 8 = P0.10)
 *   → row pin = pm14, col pin = pm8
 *
 * Pinos padrão do Corne (ZMK oficial):
 *   cols: pm4, pm5, pm6, pm7, pm8, pm9
 *   rows: pm14, pm15, pm16, pm10
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// row0 (pm10) × cols pm4-pm9
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6
// row1 (pm11) × cols pm4-pm9
&kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y
// row2 (pm12) × cols pm4-pm9
&kp A      &kp S      &kp D      &kp F      &kp G      &kp H
// row3 (pm13) × cols pm4-pm9
&kp Z      &kp X      &kp C      &kp V      &kp B      &kp N
// row4 (pm14) × cols pm4-pm9
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6
// row5 (pm15) × cols pm4-pm9
&kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
// row6 (pm16) × cols pm4-pm9
&kp F13    &kp F14    &kp F15    &kp F16    &kp F17    &kp F18
// row7 (pm17) × cols pm4-pm9
&kp F19    &kp F20    &kp F21    &kp F22    &kp F23    &kp F24
// row8 (pm18) × cols pm4-pm9
&kp ESC    &kp TAB    &kp BSPC   &kp DEL    &kp ENTER  &kp SPACE
// row9 (pm19) × cols pm4-pm9
&kp UP     &kp DOWN   &kp LEFT   &kp RIGHT  &kp INS    &kp PSCRN
            >;
        };
    };
};
